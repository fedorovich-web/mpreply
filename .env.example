APP_ENV=local
APP_NAME=MPReply
APP_VERSION=0.1.103
API_BASE_URL=http://localhost:8000
WEB_APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://mpreply:mpreply_password@localhost:5432/mpreply
REDIS_URL=redis://localhost:6379/0
AUTH_SECRET_KEY=replace-with-local-dev-secret-at-least-32-bytes
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_INVITATION_TTL_HOURS=72
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CREDENTIALS_ENCRYPTION_KEY=replace-with-fernet-compatible-key
# Optional bootstrap. Prefer the database-backed superadmin LLM settings.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.2
OPENROUTER_FALLBACK_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_TIMEOUT_SECONDS=45

PAYMENT_PROVIDER=disabled
PAYMENT_RETURN_URL=http://localhost:3000/app/billing?payment=return
PAYMENT_PROVIDER_TIMEOUT_SECONDS=20
YOOKASSA_SHOP_ID=replace-only-in-real-env
YOOKASSA_SECRET_KEY=replace-only-in-real-env
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
PAYMENT_WEBHOOK_IP_CHECK_ENABLED=true
PAYMENT_WEBHOOK_MAX_BODY_BYTES=65536
YOOKASSA_WEBHOOK_ALLOWED_NETWORKS=["185.71.76.0/27","185.71.77.0/27","77.75.153.0/25","77.75.156.11/32","77.75.156.35/32","77.75.154.128/25","2a02:5180::/32"]
PAYMENT_TRUSTED_PROXY_NETWORKS=[]
SENTRY_DSN=
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=false
AUTH_LOGIN_ACCOUNT_LIMIT=20
AUTH_LOGIN_IP_LIMIT=100
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_REGISTRATION_ACCOUNT_LIMIT=5
AUTH_REGISTRATION_IP_LIMIT=20
AUTH_REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_REFRESH_TOKEN_LIMIT=120
AUTH_REFRESH_IP_LIMIT=600
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=900
AI_DAILY_COST_LIMIT_DEFAULT=5.00
AUTO_REPLY_DAILY_LIMIT_DEFAULT=100

AUTO_REPLY_MAX_ATTEMPTS=4
AUTO_REPLY_EXECUTION_LEASE_SECONDS=120
ANSWER_RESERVATION_TTL_SECONDS=900
MARKETPLACE_SYNC_INTERVAL_SECONDS=300
SCHEDULER_POLL_INTERVAL_SECONDS=10
SCHEDULER_CLAIM_LIMIT=50
SCHEDULER_LEASE_SECONDS=180

# Public site
NEXT_PUBLIC_SITE_URL=https://mpreply.ru
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CONTACT_EMAIL=

# Editorial CMS. CMS_API_URL is server-only and CMS_READ_TOKEN must belong to
# a noninteractive service user that can read published content only.
CMS_DATABASE_URL=postgresql://mpreply_cms:mpreply_cms@localhost:5433/mpreply_cms
CMS_PUBLIC_URL=http://localhost:3001
CMS_API_URL=http://localhost:3001
CMS_READ_TOKEN=replace-only-in-real-env
CMS_REVALIDATION_URL=http://localhost:3000/api/cms/revalidate
CMS_REVALIDATION_SECRET=replace-with-local-dev-secret
CMS_REQUEST_TIMEOUT_MS=5000
PAYLOAD_SECRET=replace-with-local-dev-secret-at-least-32-bytes
# Runtime hardening / observability
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
READINESS_TIMEOUT_SECONDS=3.0
SENTRY_TRACES_SAMPLE_RATE=0.0
SECURITY_HEADERS_ENABLED=true
FORWARDED_ALLOW_IPS=127.0.0.1
TRUSTED_PROXY_HEADERS=true

# Production-only deployment metadata
DEPLOYMENT_VERSION=local
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
