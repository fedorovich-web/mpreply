APP_ENV=local
APP_NAME=MPReply
APP_VERSION=0.1.27
API_BASE_URL=http://localhost:8000
WEB_APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://respio:respio_password@localhost:5432/respio
REDIS_URL=redis://localhost:6379/0
AUTH_SECRET_KEY=replace-with-local-dev-secret-at-least-32-bytes
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_ACTION_TOKEN_COOLDOWN_SECONDS=60
CREDENTIALS_ENCRYPTION_KEY=replace-with-fernet-compatible-key

RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_TIMEOUT_SECONDS=10
TRANSACTIONAL_EMAIL_FROM=MPReply <no-reply@mpreply.ru>
SUPPORT_EMAIL=support@mpreply.ru

GROQ_API_KEY=replace-only-in-real-env
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=45
AI_REPLY_PROVIDER=groq
OPENROUTER_API_KEY=
OPENROUTER_TIMEOUT_SECONDS=45

WB_SERVICE_SECRET=
WB_INTEGRATION_MODE=cloud
WB_SELF_HOSTED_SELLER_HASH=

LAVA_ENABLED=false
LAVA_API_KEY=
LAVA_PRODUCT_ID=
LAVA_OFFER_ID=
LAVA_WEBHOOK_SECRET=
YANDEX_OAUTH_ENABLED=false
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

SENTRY_DSN=
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=false
AI_DAILY_COST_LIMIT_DEFAULT=5.00
AUTO_REPLY_DAILY_LIMIT_DEFAULT=100

AUTO_REPLY_MAX_ATTEMPTS=4
AUTO_REPLY_EXECUTION_LEASE_SECONDS=120

NEXT_PUBLIC_SITE_URL=https://mpreply.ru
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CONTACT_EMAIL=support@mpreply.ru
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
READINESS_TIMEOUT_SECONDS=3.0
SENTRY_TRACES_SAMPLE_RATE=0.0
SECURITY_HEADERS_ENABLED=true
FORWARDED_ALLOW_IPS=127.0.0.1
TRUSTED_PROXY_HEADERS=true

DEPLOYMENT_VERSION=local
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
