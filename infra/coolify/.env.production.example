# MPReply production variable inventory for Coolify.
# Example values only; never commit real secrets.
APP_VERSION=0.1.103
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
DATABASE_URL=postgresql+asyncpg://mpreply:change-me@postgres:5432/mpreply
REDIS_URL=redis://redis:6379/0
AUTH_SECRET_KEY=change-me-minimum-32-characters
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_INVITATION_TTL_HOURS=72
CREDENTIALS_ENCRYPTION_KEY=change-me-fernet-key
FORWARDED_ALLOW_IPS=127.0.0.1
OPENROUTER_API_KEY=change-me
PAYMENT_PROVIDER=disabled
PAYMENT_RETURN_URL=https://app.example.com/app/billing?payment=return
PAYMENT_PROVIDER_TIMEOUT_SECONDS=20
YOOKASSA_SHOP_ID=change-me
YOOKASSA_SECRET_KEY=change-me
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
PAYMENT_WEBHOOK_IP_CHECK_ENABLED=true
PAYMENT_WEBHOOK_MAX_BODY_BYTES=65536
YOOKASSA_WEBHOOK_ALLOWED_NETWORKS=["185.71.76.0/27","185.71.77.0/27","77.75.153.0/25","77.75.156.11/32","77.75.156.35/32","77.75.154.128/25","2a02:5180::/32"]
# Set to the actual Coolify/Traefik network when X-Forwarded-For is used.
PAYMENT_TRUSTED_PROXY_NETWORKS=[]
SENTRY_DSN=
ANSWER_RESERVATION_TTL_SECONDS=900
MARKETPLACE_SYNC_INTERVAL_SECONDS=300
SCHEDULER_POLL_INTERVAL_SECONDS=10
SCHEDULER_CLAIM_LIMIT=50
SCHEDULER_LEASE_SECONDS=180
