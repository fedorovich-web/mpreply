# MPReply production variable inventory for Coolify.
# Example values only; never commit real secrets or use these placeholders in production.

# Public routing and release identity
APP_VERSION=0.1.103
DEPLOYMENT_VERSION=replace-with-git-commit-sha
API_BASE_URL=https://api.mpreply.ru
WEB_APP_URL=https://app.mpreply.ru
PUBLIC_SITE_URL=https://mpreply.ru
NEXT_PUBLIC_API_BASE_URL=https://api.mpreply.ru
NEXT_PUBLIC_CONTACT_EMAIL=

# Application state
DATABASE_URL=postgresql+asyncpg://mpreply:change-me@mpreply-postgres-prod:5432/mpreply
REDIS_URL=redis://mpreply-redis-prod:6379/0

# Authentication and credential protection
AUTH_SECRET_KEY=change-me-minimum-32-characters
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_INVITATION_TTL_HOURS=72
AUTH_COOKIE_SAMESITE=lax
CREDENTIALS_ENCRYPTION_KEY=change-me-fernet-key

# Database-managed LLM configuration. This key is optional bootstrap only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.2
OPENROUTER_FALLBACK_MODEL=anthropic/claude-sonnet-4.6

# Billing
PAYMENT_PROVIDER=disabled
PAYMENT_RETURN_URL=https://app.mpreply.ru/app/billing?payment=return
PAYMENT_PROVIDER_TIMEOUT_SECONDS=20
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
PAYMENT_WEBHOOK_IP_CHECK_ENABLED=true
PAYMENT_WEBHOOK_MAX_BODY_BYTES=65536
YOOKASSA_WEBHOOK_ALLOWED_NETWORKS=["185.71.76.0/27","185.71.77.0/27","77.75.153.0/25","77.75.156.11/32","77.75.156.35/32","77.75.154.128/25","2a02:5180::/32"]
# Replace with the actual Coolify/Traefik network when X-Forwarded-For is used.
PAYMENT_TRUSTED_PROXY_NETWORKS=[]

# Runtime hardening and observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["https://mpreply.ru","https://app.mpreply.ru"]
ALLOWED_HOSTS=["mpreply.ru","www.mpreply.ru","app.mpreply.ru","api.mpreply.ru"]
READINESS_TIMEOUT_SECONDS=3.0
FORWARDED_ALLOW_IPS=replace-with-coolify-proxy-network
RATE_LIMIT_ENABLED=true
AUTH_LOGIN_ACCOUNT_LIMIT=20
AUTH_LOGIN_IP_LIMIT=100
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_REGISTRATION_ACCOUNT_LIMIT=5
AUTH_REGISTRATION_IP_LIMIT=20
AUTH_REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_REFRESH_TOKEN_LIMIT=120
AUTH_REFRESH_IP_LIMIT=600
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=900

# Background execution
ANSWER_RESERVATION_TTL_SECONDS=900
MARKETPLACE_SYNC_INTERVAL_SECONDS=300
SCHEDULER_POLL_INTERVAL_SECONDS=10
SCHEDULER_CLAIM_LIMIT=50
SCHEDULER_LEASE_SECONDS=180

# Editorial CMS. The database is a separate Coolify PostgreSQL resource.
CMS_DATABASE_URL=postgresql://mpreply_cms:change-me@mpreply-cms-postgres-prod:5432/mpreply_cms
CMS_PUBLIC_URL=https://cms.mpreply.ru
CMS_API_URL=http://cms:3001
CMS_READ_TOKEN=change-me-read-only-service-token
CMS_REVALIDATION_URL=http://web:3000/api/cms/revalidate
CMS_REVALIDATION_SECRET=change-me-shared-hmac-secret
CMS_REQUEST_TIMEOUT_MS=5000
PAYLOAD_SECRET=change-me-minimum-32-characters
