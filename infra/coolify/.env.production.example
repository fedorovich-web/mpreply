APP_ENV=production
APP_NAME=Respio
APP_VERSION=0.1.21
API_BASE_URL=https://api.respio.ru
WEB_APP_URL=https://app.respio.ru
PUBLIC_SITE_URL=https://respio.ru
DATABASE_URL=SET_IN_SECRET_STORAGE
REDIS_URL=SET_IN_SECRET_STORAGE
AUTH_SECRET_KEY=SET_IN_SECRET_STORAGE_MIN_32_CHARS
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
CREDENTIALS_ENCRYPTION_KEY=SET_IN_SECRET_STORAGE_VALID_FERNET_KEY
OPENROUTER_API_KEY=SET_IN_SECRET_STORAGE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.2
OPENROUTER_FALLBACK_MODEL=anthropic/claude-sonnet-4.6
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["https://app.respio.ru","https://respio.ru"]
ALLOWED_HOSTS=["api.respio.ru"]
READINESS_TIMEOUT_SECONDS=3.0
SECURITY_HEADERS_ENABLED=true
FORWARDED_ALLOW_IPS=SET_TO_COOLIFY_PROXY_IP_OR_NETWORK
DEPLOYMENT_VERSION=SET_TO_GIT_SHA_OR_RELEASE_ID
NEXT_PUBLIC_SITE_URL=https://respio.ru
NEXT_PUBLIC_API_BASE_URL=https://api.respio.ru
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=SET_IN_SECRET_STORAGE_WHEN_MULTI_INSTANCE_SERVER_ACTIONS_ARE_USED
