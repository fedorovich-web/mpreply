APP_ENV=production
APP_NAME=MPReply
APP_VERSION=0.1.27
API_BASE_URL=https://api.mpreply.ru
WEB_APP_URL=https://app.mpreply.ru
PUBLIC_SITE_URL=https://mpreply.ru
DATABASE_URL=SET_IN_DOKPLOY_ENVIRONMENT
REDIS_URL=SET_IN_DOKPLOY_ENVIRONMENT
AUTH_SECRET_KEY=SET_IN_DOKPLOY_ENVIRONMENT_MIN_32_CHARS
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
CREDENTIALS_ENCRYPTION_KEY=SET_IN_DOKPLOY_ENVIRONMENT_VALID_FERNET_KEY
GROQ_API_KEY=SET_IN_DOKPLOY_ENVIRONMENT
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=45
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["https://app.mpreply.ru","https://mpreply.ru"]
ALLOWED_HOSTS=["api.mpreply.ru"]
READINESS_TIMEOUT_SECONDS=3.0
SECURITY_HEADERS_ENABLED=true
FORWARDED_ALLOW_IPS=SET_TO_DOKPLOY_TRAEFIK_IP_OR_NETWORK
DEPLOYMENT_VERSION=SET_TO_GIT_SHA_OR_RELEASE_ID
NEXT_PUBLIC_SITE_URL=https://mpreply.ru
NEXT_PUBLIC_API_BASE_URL=https://api.mpreply.ru
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=SET_IN_DOKPLOY_ENVIRONMENT_WHEN_MULTI_INSTANCE_SERVER_ACTIONS_ARE_USED
