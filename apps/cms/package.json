{
  "name": "mpreply-cms",
  "version": "0.1.103",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "payload generate:importmap && next build",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "graphql": "16.14.2",
    "next": "16.2.11",
    "payload": "3.88.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "25.0.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "dompurify": "3.4.14",
    "esbuild": "0.28.2",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
