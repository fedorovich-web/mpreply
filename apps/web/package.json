{
  "name": "mpreply-web",
  "version": "0.1.103",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "design:detect": "impeccable detect app components styles",
    "design:detect:json": "impeccable detect --json app components styles",
    "impeccable:install": "impeccable skills install -y --providers=claude,codex --scope=project",
    "test:e2e": "playwright test e2e/public-site.spec.ts e2e/automation-rules.spec.ts e2e/ai-assistant.spec.ts e2e/integrations.spec.ts --project=chromium",
    "test:e2e:all": "playwright test e2e/public-site.spec.ts e2e/automation-rules.spec.ts e2e/ai-assistant.spec.ts e2e/integrations.spec.ts",
    "test:a11y": "playwright test e2e/accessibility.spec.ts e2e/automation-rules-accessibility.spec.ts e2e/ai-assistant-accessibility.spec.ts e2e/integrations-accessibility.spec.ts e2e/dark-theme-accessibility.spec.ts --project=chromium",
    "test:visual": "playwright test e2e/visual.spec.ts --project=chromium",
    "test:visual:update": "playwright test e2e/visual.spec.ts --project=chromium --update-snapshots",
    "test:report": "playwright show-report",
    "lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "qa:web": "npm run test:frontend && npm run design:detect && npm run typecheck && npm run lint && npm run validate:css-syntax && npm run build && npm run validate:w3c",
    "test:unit": "vitest run tests/unit --maxWorkers=1",
    "test:design-tokens": "vitest run tests/design",
    "test:frontend": "npm run test:unit && npm run test:design-tokens",
    "validate:w3c:html": "node scripts/validate-w3c-html.mjs",
    "validate:w3c:css": "node scripts/validate-w3c-css.mjs",
    "validate:w3c": "npm run validate:w3c:css && npm run validate:w3c:html",
    "validate:css-syntax": "csstree-validator styles",
    "clean:next": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev:clean": "npm run clean:next && next dev --hostname 0.0.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.12",
    "next": "16.2.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "0.185.1",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.0.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "csstree-validator": "4.0.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "impeccable": "3.2.1",
    "jsdom": "29.1.1",
    "proxy-agent": "8.0.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vnu-jar": "26.7.11"
  },
  "overrides": {
    "postcss": "8.5.23",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "chrome-launcher": "1.2.1",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
